def insertion_sort(arr):
    for i in range(1, len(arr)):
        key = arr[i]
        j = i - 1

        while j >= 0 and arr[j] < key:
            arr[j + 1] = arr[j]
            j -= 1
            arr[j + 1] = key


#Example
unsorted_numbers = [13, 6, 9, 4, 16, 8]

print("Unsorted list:", unsorted_numbers)

